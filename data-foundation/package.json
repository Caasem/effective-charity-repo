{
  "name": "@effective-charity/data-foundation",
  "version": "0.1.0",
  "private": true,
  "description": "Philanthropy Data Foundation: ingestion, entity resolution and knowledge graph for the Effective Charity network.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "ingest:companies-house": "ts-node src/ingest/companiesHouse.ts",
    "ingest:charity-commission": "ts-node src/ingest/charityCommission.ts",
    "ingest:official": "ts-node src/ingest/officialSources.ts",
    "ingest:regulators": "ts-node src/ingest/regulatorSources.ts",
    "extract:facts": "ts-node src/ingest/extractFacts.ts",
    "profiles:build": "ts-node src/profiles/buildProfiles.ts",
    "resolve:entities": "ts-node src/entity-resolution/run.ts",
    "graph:build": "ts-node src/graph/build.ts",
    "pipeline:all": "npm run ingest:charity-commission && npm run ingest:companies-house && npm run ingest:official && npm run resolve:entities && npm run graph:build",
    "test": "ts-node src/tests/foundation.test.ts",
    "viewer": "ts-node viewer/server.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "https-proxy-agent": "^5.0.1",
    "node-fetch": "^2.7.0",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.25",
    "@types/node": "^22.7.4",
    "@types/node-fetch": "^2.6.11",
    "@types/unzipper": "^0.10.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
