# --- Companies House ---
# Free. Register at https://developer.company-information.service.gov.uk
# Create an application (any type), copy its REST API key.
COMPANIES_HOUSE_API_KEY=

# --- Charity Commission ---
# Two independent ways to get charity data. Use either or both.
#
# Option A (recommended, no key needed): the daily open-data extract.
#   1. Visit https://register-of-charities.charitycommission.gov.uk/en/register/full-register-download
#   2. Right-click "download json" next to the `charity` table and copy the link address
#      (the URL rotates/is versioned, so it must be re-copied periodically — the ingester
#      will tell you clearly if the link has gone stale).
#   3. Paste it below.
CHARITY_COMMISSION_EXTRACT_URL=

# Option B (official REST API, needs free registration + subscription key).
# This is what enriches the three pilot charities (Islamic Relief Worldwide,
# Muslim Aid, Human Appeal) with decoded classification, area of operation,
# trustees and 5-year financial history — the extract in Option A only gives
# raw tags, no per-charity trustee/financial detail.
#   1. Register at https://api-portal.charitycommission.gov.uk/signup and
#      create a subscription.
#   2. The portal gives you both values below — copy them exactly; the base
#      URL is not a stable well-known host and can't be guessed or defaulted.
CHARITY_COMMISSION_API_KEY=
CHARITY_COMMISSION_API_BASE_URL=

# --- Storage ---
# SQLite file the whole pipeline reads/writes. Swap for POSTGRES_URL later
# to point the same schema at the real Postgres database (see database/schema.sql
# in the main project — the graph tables below are additive to it).
DATA_FOUNDATION_DB=./data/foundation.sqlite
SOURCE_SNAPSHOT_DIR=./data/source-snapshots

# Optional annual report URLs, copied from each organisation's official site.
# Leave blank until the exact report/document URL has been manually verified.
ISLAMIC_RELIEF_ANNUAL_REPORT_URL=
MUSLIM_AID_ANNUAL_REPORT_URL=
HUMAN_APPEAL_ANNUAL_REPORT_URL=
