{
  "expo": {
    "name": "Effective Charity",
    "slug": "effective-charity",
    "scheme": "effectivecharity",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0B0D",
    "plugins": ["expo-router"],
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.effectivecharity.app"
    },
    "android": {
      "package": "com.effectivecharity.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0B0D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "Effective Charity",
      "shortName": "Effective Charity",
      "description": "A trusted network for Muslim philanthropy.",
      "lang": "en",
      "themeColor": "#00D68F",
      "backgroundColor": "#0A0B0D"
    }
  }
}
